{
  "definitions": [
    {
      "title": "Icon List",
      "id": "icon-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Icon List",
              "model": "icon-list",
              "filter": "icon-list"
            }
          }
        }
      }
    },
    {
      "title": "Icon Cards Item",
      "id": "icon-cards",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Icon Cards Item",
              "model": "icon-cards"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "icon-list",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "List Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "description",
          "label": "List Description"
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Cards Per Row",
          "value": "cols-4",
          "options": [
            { "name": "2 Cards Per Row", "value": "cols-2" },
            { "name": "3 Cards Per Row", "value": "cols-3" },
            { "name": "4 Cards Per Row", "value": "cols-4" },
            { "name": "5 Cards Per Row", "value": "cols-5" }
          ]
        }
      ]
    },
    {
      "id": "icon-cards",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "component": "select",
          "name": "view",
          "label": "View Option",
          "value": "card-image-top",
          "options": [
            { "name": "Card Image Top", "value": "card-image-top" }
          ]
        },
        {
          "component": "select",
          "name": "defaultCardColor",
          "label": "Default Card Color",
          "value": "blue",
          "options": [
            { "name": "Blue", "value": "blue" },
            { "name": "Grey", "value": "grey" },
            { "name": "Black", "value": "black" }
          ]
        },
        {
          "component": "boolean",
          "name": "showIcon",
          "label": "Show Icon Toggle",
          "value": true
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "icon",
          "label": "Upload Icon",
          "condition": {
            "===": [{ "var": "showIcon" }, true]
          }
        },
        {
          "component": "boolean",
          "name": "showTitle",
          "label": "Show Title Toggle",
          "value": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title / Statistic Text",
          "condition": {
            "===": [{ "var": "showTitle" }, true]
          }
        },
        {
          "component": "boolean",
          "name": "showDesc",
          "label": "Show Description Toggle",
          "value": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "description",
          "label": "Description Text",
          "condition": {
            "===": [{ "var": "showDesc" }, true]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "cardBgImage",
          "label": "Card BG Image"
        },
        {
          "component": "select",
          "name": "motionType",
          "label": "Motion Type",
          "value": "none",
          "options": [
            { "name": "None", "value": "none" },
            { "name": "Hover Lift", "value": "hover-lift" },
            { "name": "Fade In", "value": "fade-in" }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "icon-list",
      "components": [
        "icon-cards"
      ]
    }
  ]
}